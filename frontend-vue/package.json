{
  "name": "money-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "src/app/main.ts",
    "src/app/providers/styles.ts",
    "src/shared/mud/vendor/MudBlazor.min.js",
    "src/shared/mud/vendor/MudTimePicker.min.js"
  ],
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test --project=specs",
    "api:gen": "node scripts/api-gen.mjs",
    "api:check": "node scripts/api-check.mjs",
    "size:check": "node scripts/size-budget.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build && pnpm size:check",
    "verify:full": "pnpm api:check && pnpm verify"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@tanstack/vue-query": "^5.102.0",
    "@vueuse/core": "^14.4.0",
    "chart.js": "^4.5.1",
    "decimal.js": "^10.6.0",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.9.0",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "openapi-typescript": "^7.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
    "yaml": "^2.9.0"
  }
}
