<MudCard Class="@ClassName">
    <MudCardHeader Style="padding: 4px 6px;">
        <MudTooltip RootClass="mud-card-header-text"
                    Text="@Model.Name">
            <MudText Class="mud-card-header-text"
                     Typo="Typo.h6">
                @Model.Name
            </MudText>
        </MudTooltip>
    </MudCardHeader>
    <MudCardContent Style="padding: 4px 6px">
        <MudTooltip Arrow
                    Placement="Placement.Right"
                    Text="Категория">
            <MudText Typo="Typo.subtitle2">@Model.Category.Name</MudText>
        </MudTooltip>

        <MudDivider Class="mb-1" />

        <MudTooltip Arrow
                    Placement="Placement.Right"
                    Text="Сумма">
            <MudText Typo="Typo.body2">@Model.Sum</MudText>
        </MudTooltip>

        @if (!string.IsNullOrEmpty(Model.Place))
        {
            <MudDivider Class="mb-1" />

            <MudTooltip Arrow
                        Placement="Placement.Right"
                        Text="Место">
                <MudText Typo="Typo.body2">@Model.Place</MudText>
            </MudTooltip>
        }

        @if (!string.IsNullOrEmpty(Model.Comment))
        {
            <MudDivider Class="mb-1" />

            <MudTooltip Arrow
                        Placement="Placement.Right"
                        Text="Комментарий">
                <MudText Typo="Typo.body2">@Model.Comment</MudText>
            </MudTooltip>
        }
    </MudCardContent>
    <MudCardActions Style="padding: 4px 2px">
        <MudTooltip Text="Следующий запуск">
            <MudChip Icon="@Icons.Material.Rounded.CalendarToday"
                     Size="Size.Small"
                     T="string"
                     Text="@(Model.RunTime?.ToShortDateString() ?? "\u221e")" />
        </MudTooltip>

        <MudSpacer />

        @if (Model.IsDeleted)
        {
            <MudTooltip Text="Восстановить">
                <MudIconButton Color="Color.Success"
                               Icon="@Icons.Material.Rounded.Restore"
                               OnClick="() => Restore(Model)"
                               Size="Size.Small" />
            </MudTooltip>
        }
        else
        {
            <MudTooltip Text="Редактировать">
                <MudIconButton Color="Color.Warning"
                               Icon="@Icons.Material.Rounded.Edit"
                               OnClick="() => Update(Model)"
                               Size="Size.Small" />
            </MudTooltip>

            <MudTooltip Text="Удалить">
                <MudIconButton Class="trash-btn"
                               Color="Color.Default"
                               Icon="@Icons.Material.Rounded.Delete"
                               OnClick="() => Delete(Model)"
                               Size="Size.Small" />
            </MudTooltip>
        }
    </MudCardActions>
</MudCard>
